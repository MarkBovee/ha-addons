                      "type": "column"
                    },
                    {
                      "color": "grey",
                      "data_generator": "const exportCurve = entity.attributes.price_curve;\nconst importCurve =\n  hass.states['sensor.energy_prices_electricity_import_price']\n  ?.attributes?.price_curve;\n\nif (!exportCurve || !importCurve) return [];\n\nreturn exportCurve.map((e, idx) => {\n  const imp = importCurve[idx]?.price ?? 0;\n  const delta = Math.max(e.price - imp, 0);\n  return [new Date(e.start).getTime(), delta];\n});\n",
                      "entity": "sensor.energy_prices_electricity_export_price",
                      "float_precision": 3,
                      "name": "Export bonus",
                      "opacity": 0.9,
                      "show": {
