              "features_position": "bottom",
              "icon": "{% set soc = states('sensor.ev4_ev_battery_level') | int(0) %}\n{% if soc >= 90 %}\n  mdi:battery\n{% elif soc >= 70 %}\n  mdi:battery-80\n{% elif soc >= 50 %}\n  mdi:battery-60\n{% elif soc >= 30 %}\n  mdi:battery-40\n{% elif soc >= 10 %}\n  mdi:battery-20\n{% else %}\n  mdi:battery-alert\n{% endif %}\n",
              "primary": "{% if is_state('binary_sensor.charge_amps_monitor_charger_charging', 'on') %}\n  Kia EV4 (charging)\n{% else %}\n  Kia EV4\n{% endif %}\n",
              "secondary": "{% set charging = is_state('binary_sensor.charge_amps_monitor_charger_charging', 'on') %} {% set power = states('sensor.charge_amps_monitor_charger_current_power') | int(0) %} {% set soc = states('sensor.ev4_ev_battery_level') %}\n{% if charging %}\n  {% if soc not in ['unknown', 'unavailable', 'none', ''] %}\n    Power: {{ power }}W • SOC: {{ soc | int }}%\n  {% else %}\n    Power: {{ power }}W\n  {% endif %}\n{% else %}\n  {% if soc not in ['unknown', 'unavailable', 'none', ''] %}\n    SOC: {{ soc | int }}%\n  {% else %}\n    Not connected\n  {% endif %}\n{% endif %}\n",
