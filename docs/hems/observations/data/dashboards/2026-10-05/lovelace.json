                      "data_generator": "const curve = entity.attributes.price_curve;\nif (!curve) return [];\nreturn curve.map(i => [new Date(i.start).getTime(), i.price]);\n",
                      "entity": "sensor.energy_prices_electricity_import_price",
                      "float_precision": 3,
                      "name": "Import",
